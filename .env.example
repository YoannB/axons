# --- Server (NEVER prefixed NEXT_PUBLIC_, NEVER exposed to the browser bundle) ---
OPENROUTER_API_KEY=
# OpenRouter model id (check it in the catalog at deploy time).
OPENROUTER_MODEL=openrouter/free

# --- Server AI quota (Netlify Blobs, see docs/ai-capabilities.md → Rate limit) ---
# HMAC secret for IPs (>= 32 characters, REQUIRED in production). Generate: openssl rand -base64 48
AI_QUOTA_SECRET=
# TOTAL AI calls per UTC day, all IPs combined (default 1000).
AI_GLOBAL_DAILY_CAP=1000
# Burst: max calls per minute per IP (default 2).
AI_RATE_PER_MIN=2
# Store unavailable in production: closed = 503 (default, protects the budget) | open = let calls through.
AI_QUOTA_FAIL_MODE=closed
# Temporary diagnostics: 1 = trace every Netlify Blobs quota request in the function logs.
AI_QUOTA_DEBUG=
# Reminder: the HARD financial cap is the credit limit of the OpenRouter key.

# --- Public (inlined by Next; also exposed to Vitest via process.env) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Default locale (i18n/locales.ts). Must be one of the served locales, otherwise the build fails.
# Single-language site: reduce LOCALES in i18n/locales.ts to that one locale.
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Daily AI calls per user (0 or empty = feature hidden).
# Same value enforced client-side (localStorage) AND server-side (per IP, Netlify Blobs).
NEXT_PUBLIC_AI_DAILY_LIMIT=3
# Google Tag Manager (empty = not loaded).
NEXT_PUBLIC_GTM_ID=
# Ads: false until real tags are wired (hidden in PROD).
NEXT_PUBLIC_ADS_ENABLED=false

# --- Legal / publisher information (server-only, injected into messages/*.json) ---
# Never commit real values in this file.
# Set these variables in .env.local locally, and in Netlify > Site configuration > Environment variables.
LEGAL_EDITOR_NAME=
LEGAL_EDITOR_TRADE_NAME=
LEGAL_EDITOR_SIREN=
LEGAL_EDITOR_APE_CODE=
LEGAL_EDITOR_ADDRESS=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_CONTACT_EMAIL=
# Expected ISO 8601 date: YYYY-MM-DD. It is formatted according to the current locale.
LEGAL_ACTIVITY_DECLARED_DATE=